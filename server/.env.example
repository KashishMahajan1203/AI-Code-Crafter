# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas or local instance
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/codecrafter
# Optional: DNS servers used for SRV lookups
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# AI provider (kept server-side only)
OPENROUTER_API_KEY=
# Optional: comma-separated models tried in order (defaults are in
# controllers/generation.controller.js). The first one that returns a
# usable project wins.
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# HTTPS: enforced automatically when NODE_ENV=production.
# FORCE_HTTPS=true
# Number of reverse proxies in front of the app (1 for Nginx/Render/Railway)
# TRUST_PROXY=1
